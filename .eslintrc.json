{
    "extends": ["next", "prettier"],
    "rules": {
        "array-bracket-spacing": "warn",
        "comma-spacing": "warn",
        "eqeqeq": "warn",
        "func-call-spacing": "warn",
        "key-spacing": "warn",
        "no-unused-vars": "warn",
        "object-curly-spacing": "warn",
        "semi": "warn"
    }
}
